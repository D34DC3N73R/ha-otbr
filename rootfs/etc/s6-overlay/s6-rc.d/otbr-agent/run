#!/usr/bin/with-contenv bash
# vim: ft=bash
# shellcheck shell=bash
# ==============================================================================
# OpenThread BorderRouter start script
# ==============================================================================

# shellcheck source=./rootfs/etc/s6-overlay/scripts/otbr-agent-common
. /etc/s6-overlay/scripts/otbr-agent-common

declare backbone_if
declare device
declare baudrate
declare flow_control
declare migrate_flow_control
declare otbr_log_level_int
declare otbr_rest_listen
declare otbr_rest_listen_port

# Prefer explicit BACKBONE_IF config (env BACKBONE_IF) when provided,
# otherwise fall back to whichever interface holds the default route.
if config_has_value 'backbone_if'; then
    backbone_if="$(config_get 'backbone_if')"
else
    backbone_if="$(primary_interface)"
fi

if [ -z "${backbone_if}" ]; then
    exit_nok "No primary network interface found. Set BACKBONE_IF to the interface facing your LAN."
fi
log_info "Using backbone interface: ${backbone_if}"

# Check if IPv6 forwarding is enabled
if [ "$(cat /proc/sys/net/ipv6/conf/all/forwarding)" != "1" ]; then
    log_warn "IPv6 routing/forwarding is not enabled! Make sure the host has IPv6 forwarding enabled."
fi

device=$(config_get 'device')

if config_has_value 'network_device'; then
    device="/tmp/ttyOTBR"
elif ! var_has_value "${device}"; then
    exit_nok "No radio configured. Set DEVICE to your serial adapter, or NETWORK_DEVICE to a TCP address."
fi

baudrate=$(config_get 'baudrate')
flow_control=""

if config_true 'flow_control'; then
    flow_control="&uart-flow-control"
    migrate_flow_control="hardware"
else
    flow_control="&uart-init-deassert"
    migrate_flow_control="none"
fi

otbr_log_level_int="$(otbr_log_level_to_int)" \
    || exit_nok "Unknown otbr_log_level: $(config_get otbr_log_level)"

# shellcheck disable=SC2015
mkdir -p /data/thread && ln -sft /var/lib /data/thread || exit_nok "Could not create directory /var/lib/thread to store Thread data."

# We compile the OTBR with firewall support, so otbr-agent tries to update the
# ipsets. Therefor, create ipsets always to avoid errors from otbr-agent. Just
# the ipsets  won't have an effect in practice when the firewall is disabled.
ipset create -exist otbr-ingress-deny-src hash:net family inet6
ipset create -exist otbr-ingress-deny-src-swap hash:net family inet6
ipset create -exist otbr-ingress-allow-dst hash:net family inet6
ipset create -exist otbr-ingress-allow-dst-swap hash:net family inet6

reset_forward_chain ip6tables "${otbr_forward_ingress_chain}" -o "${thread_if}"
ip6tables -I FORWARD 1 -o "${thread_if}" -j "${otbr_forward_ingress_chain}"

reset_forward_chain ip6tables "${otbr_forward_egress_chain}" -i "${thread_if}"
ip6tables -I FORWARD 2 -i "${thread_if}" -j "${otbr_forward_egress_chain}"

if config_true 'firewall'; then
    log_info "Setup OTBR firewall..."

    ip6tables -A "${otbr_forward_ingress_chain}" -m pkttype --pkt-type unicast -i "${thread_if}" -j DROP
    ip6tables -A "${otbr_forward_ingress_chain}" -m set --match-set otbr-ingress-deny-src src -j DROP
    ip6tables -A "${otbr_forward_ingress_chain}" -m set --match-set otbr-ingress-allow-dst dst -j ACCEPT
    ip6tables -A "${otbr_forward_ingress_chain}" -m pkttype --pkt-type unicast -j DROP
    ip6tables -A "${otbr_forward_ingress_chain}" -j ACCEPT

    ip6tables -A "${otbr_forward_egress_chain}" -j ACCEPT
else
    ip6tables -A "${otbr_forward_ingress_chain}" -j ACCEPT

    ip6tables -A "${otbr_forward_egress_chain}" -j ACCEPT
fi

if config_true 'nat64'; then
    # Mark Thread traffic in mangle
    iptables -t mangle -C PREROUTING -i "${thread_if}" -j MARK --set-mark "${otbr_fw_mark}" 2> /dev/null \
        || iptables -t mangle -A PREROUTING -i "${thread_if}" -j MARK --set-mark "${otbr_fw_mark}"

    # MASQUERADE marked traffic
    iptables -t nat -C POSTROUTING -m mark --mark "${otbr_fw_mark}" -j MASQUERADE 2> /dev/null \
        || iptables -t nat -A POSTROUTING -m mark --mark "${otbr_fw_mark}" -j MASQUERADE

    # NAT64 forward chain — jump unconditionally, filter inside
    reset_forward_chain iptables "${otbr_forward_nat64_chain}"
    iptables -I FORWARD 1 -j "${otbr_forward_nat64_chain}"

    # Forward marked traffic
    iptables -A "${otbr_forward_nat64_chain}" -m mark --mark "${otbr_fw_mark}" -o "${backbone_if}" -j ACCEPT
    # Use conntrack to identify return traffic
    iptables -A "${otbr_forward_nat64_chain}" -m conntrack --ctstate ESTABLISHED,RELATED -i "${backbone_if}" -o "${thread_if}" -j ACCEPT
fi

otbr_rest_listen_port="8081"

# REST API port is hardcoded to 8081 as otbr-web and other components expect this
if var_has_value "$(addon_port 8081)"; then
    # Port specified - bind to all interfaces
    otbr_rest_listen="::"
else
    # Port not specified - listen on localhost only for security
    otbr_rest_listen="$(addon_ip_address)"
fi

# Store REST API listen information for check script
echo "${otbr_rest_listen}" > /tmp/otbr-agent-rest-api
echo "${otbr_rest_listen_port}" >> /tmp/otbr-agent-rest-api

# Migrate OTBR settings to new adapter if needed
log_info "Migrating OTBR settings if needed..."
python3 /usr/local/bin/migrate_otbr_settings.py \
    --adapter "${device}" \
    --baudrate "${baudrate}" \
    --flow-control "${migrate_flow_control}" \
    --data-dir /data/thread/ || log_warn "Settings migration failed"

log_info "Starting otbr-agent..."
# Do not pipe this into a log filter: `exec cmd | filter` leaves the shell as
# the supervised process, so s6 signals never reach otbr-agent and the exit
# code the finish script sees belongs to the filter. Noisy P-Netif/DuaManager
# warnings on startup are expected and harmless (the add-on logs them too).
# shellcheck disable=SC2086
exec s6-notifyoncheck -d -s 300 -w 300 -n 0 stdbuf -oL \
    "/usr/sbin/otbr-agent" -I ${thread_if} -B "${backbone_if}" \
        --rest-listen-address "${otbr_rest_listen}" \
        -d${otbr_log_level_int} -v -s \
        "spinel+hdlc+uart://${device}?uart-baudrate=${baudrate}${flow_control}" \
        "trel://${backbone_if}"
